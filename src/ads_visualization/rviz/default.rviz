# =============================================================================
#  默认 RViz 布局：点云 + TF + 车模型（P0a）+ 车道图与全局路径（P1）
#
#  ⚠️ 四个容易踩的坑，都已经在下面配好，改动时留意。
#     前三个是同一类：**QoS 配不上时 RViz 不报错，只是什么都不显示**。
#
#  1. RobotModel 的 Description Topic 必须用 Transient Local 持久性。
#     robot_state_publisher 只在启动时发一次 /robot_description（latched）。
#     RViz 若用默认的 Volatile 订阅，晚启动就永远收不到 ——
#     现象是 TF 正常、点云正常，唯独车是空的，而且不报任何错。
#
#  2. PointCloud2 的 Reliability 必须用 Best Effort。
#     发布端 pointcloud_to_base_link 用的是 SensorDataQoS（best-effort）。
#     RViz 默认是 Reliable，而 best-effort 发布者 + reliable 订阅者
#     **QoS 不兼容**，连接根本建立不起来，同样是静默地什么都不显示。
#
#  3. LaneGraph 的 Durability 必须用 Transient Local，与第 1 条同理：
#     map_node 只在启动时发一次车道图。
#
#  4. Tools 里必须有 SetGoal（工具栏的 "2D Goal Pose"）。
#     缺了它，车道图看得见但**点不出路径** —— 而这看起来像路由坏了。
#
#  ⚠️ 从 RViz 图形界面「Save Config」会重写本文件并**删掉以上注释**。
#     调完布局要保存的话，记得把这段注释补回来。
# =============================================================================
Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
      Splitter Ratio: 0.5
    Tree Height: 640
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 5
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description File: ""
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Name: RobotModel
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 1.5
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree Height: 200
      Update Interval: 0
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      # 按 z 高度染色：地面和障碍物一眼分得开，比单色好用得多
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: LidarPoints
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.03
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /lidar/points
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    # -------------------------------------------------------------------------
    #  P1：车道图（青蓝 = 常规道路，橙 = 路口连接道路，白箭头 = 行驶方向）
    #
    #  ⚠️ Durability 必须是 Transient Local，与 RobotModel 同理：
    #     map_node 在启动时**只发一次**车道图。RViz 用默认的 Volatile 订阅时，
    #     只要它晚于 map_node 启动就永远收不到 —— 话题在、发布者在、
    #     RViz 一片空白，还不报错。
    # -------------------------------------------------------------------------
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: LaneGraph
      Namespaces:
        {}
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map/lane_graph
      Value: true
    # -------------------------------------------------------------------------
    #  P1：全局路径。用工具栏的 "2D Goal Pose" 点一个终点即可。
    #
    #  Line Style 用 Billboards 而不是 Lines：Lines 画出来永远是 1 px 宽，
    #  在 180×100 m 的园区上从高处看几乎不可见。
    # -------------------------------------------------------------------------
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 60; 255; 60
      Enabled: true
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Billboards
      Line Width: 0.4
      Name: RoutePath
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic:
        Depth: 1
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /route/path
      Value: true
      # P6 的交付物：他车未来 3 s 预测轨迹（线 + 2σ 椭圆）。
      # 周期性发布（每帧感知触发一次）—— Volatile 即可，参照 RoutePath；
      # 只发一次的才要 Transient Local（LaneGraph 那条的注释）。
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Prediction
      Namespaces:
        {}
      Topic:
        Depth: 1
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /prediction/markers
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    # 固定坐标系用 map：这样车在画面里是动的、世界是静的。
    # 换成 base_link 则变成车不动、世界倒着跑 —— 调传感器外参时那样更方便。
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    # P1：工具栏里的 "2D Goal Pose"。点一下地图就发一条 /goal_pose，
    # map_node 收到后算全局路径。**没有这个 Tool，车道图能看见但点不出路径**。
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      # 120 m：园区环线是 180×100 m，30 m 的话只看得见车周围一小块，
      # 车道图铺开之后完全不知道自己在图的哪个位置。
      Distance: 120
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.6
      # 相机跟着车走。留空则相机固定在世界里，车开出去就跑出画面了。
      Target Frame: base_link
      Value: Orbit (rviz_default_plugins)
      Yaw: 3.1
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  Views:
    collapsed: true
  Width: 1600
  X: 60
  Y: 40
