<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>carla_bridge</name>
  <version>0.1.0</version>
  <description>
    CARLA 侧翻译层（SPEC §4.1 环境 B，P8-S4）。
    双通道：高频传感器走 CARLA 0.9.16 原生 ROS 2（服务端内嵌 Fast DDS），
    低频轻量（TF 树 / 车辆状态 / 控制反向通道 / 地图加载 / NPC）走本包的
    PythonAPI sidecar。对外契约与 gazebo_bridge 完全相同 ——
    scripts/verify_ros_bridge.sh 换 LAUNCH_PKG 原样验收。
  </description>
  <maintainer email="suns1377154414@gmail.com">孙帅</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>ads_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <!-- launch 期要读它们的 share（xodr / URDF / lidar_preprocessor 可执行） -->
  <exec_depend>ads_map</exec_depend>
  <exec_depend>ads_visualization</exec_depend>
  <exec_depend>gazebo_bridge</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <!-- ⚠️ 没有 carla 的 rosdep 依赖：PythonAPI wheel 只装在云机上。
       sidecar 对 carla 的 import 是**惰性**的（进 main 才 import），
       所以本包在本机可构建、可 lint、可跑纯数学 L1 —— dry-run 的前提。 -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
