<?xml version="1.0"?>
<!-- Gazebo 模型元数据。model.sdf 是生成物，本文件也由 gen_obstacles.py 生成
     （它含场景描述，而描述在 YAML 里，手写就会漂移）。 -->
<model>
  <name>campus_obstacles_block</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    车道正中的锥桶 —— 几何上无解，规划器应当报不可行并停住
    由 scripts/gen_obstacles.py 从 config/obstacles.yaml 生成。
  </description>
</model>
