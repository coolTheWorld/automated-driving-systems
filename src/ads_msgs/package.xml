<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ads_msgs</name>
  <version>0.1.0</version>
  <description>
    自动驾驶栈的自定义消息接口。这是所有模块之间的契约层 ——
    改动这里会影响全部下游模块，动手前先看 CLAUDE.md 的「先问后做」。
  </description>
  <maintainer email="31771510+coolTheWorld@users.noreply.github.com">孙帅</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <!-- clang-format 取代默认的 uncrustify，见 .clang-format 顶部说明 -->
  <test_depend>ament_cmake_clang_format</test_depend>

  <!-- package format 3 的 schema 规定：一旦出现 member_of_group，后面就只允许再跟
       member_of_group 或 export。所以**所有 *_depend 必须排在它前面**。
       放反了 xmllint 会报 "element test_depend: This element is not expected"，
       但 colcon build 照样成功 —— 只有 lint 才会发现。 -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
