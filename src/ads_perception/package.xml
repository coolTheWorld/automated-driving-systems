<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ads_perception</name>
  <version>0.1.0</version>
  <description>
    点云感知：地面分割 → 欧式聚类 → L-Shape 朝向拟合 → 匈牙利匹配 + EKF 多目标跟踪。

    ⚠️ 本包**不引入 PCL**。那是重型依赖（属于 CLAUDE.md「先问后做」的范围），
    而园区一帧只有 2–5 万点，自己写体素栅格搜索足够快，且每一行都能讲清原理。
    真需要它的时候（P8 上 CARLA、点数上百万）再谈。
  </description>
  <maintainer email="suns1377154414@gmail.com">孙帅</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Eigen：头文件库，与 ads_localization 同一个理由，不是新依赖。 -->
  <build_depend>eigen3_cmake_module</build_depend>
  <buildtool_export_depend>eigen3_cmake_module</buildtool_export_depend>
  <depend>eigen</depend>

  <!-- RequireFinite 三兄弟。纯 C++、无 ROS。 -->
  <depend>ads_common</depend>

  <!-- 节点层（node/perception_node.cpp）。
       ⚠️ 这些依赖属于 perception_node 这个 target，
          libads_perception.so 依然**一个 ROS 库都不许链接** ——
          由 target_link_libraries 的作用域 + no_ros_dependencies 那道 CTest 保证。 -->
  <depend>rclcpp</depend>
  <depend>ads_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_clang_format</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_ros</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>rosgraph_msgs</test_depend>
  <test_depend>sensor_msgs_py</test_depend>
  <test_depend>tf2_ros_py</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
