<?xml version="1.0"?>
<!-- Gazebo 模型元数据。model.sdf 是生成物，本文件不含任何物理参数，可以手写。 -->
<model>
  <name>ego_vehicle</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    园区自动驾驶自车模型。几何与动力学参数全部来自 config/vehicle_params.yaml，
    经 scripts/gen_vehicle_model.py 生成 model.sdf —— 不要直接编辑 model.sdf。
    base_link 位于后轴中心、地面高度（Autoware 惯例）。
  </description>
</model>
