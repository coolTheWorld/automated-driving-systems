<?xml version="1.0"?>
<!-- Gazebo 模型元数据。model.sdf 是生成物，本文件不含任何几何，可以手写。 -->
<model>
  <name>campus_road</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    园区道路的可视几何。由 scripts/gen_map.py 从 config/campus_map.yaml 生成
    model.sdf —— 不要直接编辑 model.sdf。

    它与 maps/campus.xodr 同源：同一份 YAML、同一套几何求值代码。
    这是 SPEC §4.1「地图单一来源」的落地 —— Gazebo 看到的路和 ads_map
    认为的车道，不可能漂移。

    只有 visual 没有 collision：车在 ground_plane 上跑，路面只是贴图。
  </description>
</model>
