# colcon 构建产物
build/
install/
log/

# 由 scripts/setup_env.sh 生成，含机器相关的 UID/GID
.env

# 数据（rosbag 可能很大，不进 git）
logs/
*.mcap
*.db3

# core dump。仿真进程被 SIGKILL 时会在仓库根目录留下 core.<pid>，
# 一个就有几百 MB（Gazebo 驻留内存大），几次下来能到 GB 量级。
# 收尾请用 SIGINT + 进程组（见 CLAUDE.md 陷阱表），别直接 kill -9。
core.*

# 编辑器
.vscode/
.idea/
*.swp

# Python
__pycache__/
*.pyc

# =============================================================================
#  凭据 —— 绝不入库
#
#  `git add -A` 会把工作区里一切未忽略的东西都扫进来 —— 它没有恶意，它只是听话。
#  本地必须有防线，不能指望远端的检查。凭据不该放在仓库目录里，这几行只是兜底，不是许可。
# =============================================================================
.ssh/
*.pem
*id_rsa*
*id_ed25519*

# P7-S4 验收编排的临时工作目录（容器侧要用，不入库）
.p7s4/

# L3 全场景一键跑的过程产物（metrics/history.csv 入库，过程 CSV/日志不入）
.scenario_runs/
.p8s2b/
.p8s2c/

# P9 窗口 4 云上产物（本地复算用，不入库）
.p9w4/

# 探针/轮次产物：p9_timing_probe / l3c_* / 云窗口 .w6_* 一类，默认落在仓库根 —— 归档去 .p9w4/，不入库
.timing_*
.w[0-9]_*
.w[0-9][0-9]_*
.l3c_*
.l3g_*
.p9*

# Claude Code 的本机权限白名单（机器相关，不入库）
.claude/settings.local.json
