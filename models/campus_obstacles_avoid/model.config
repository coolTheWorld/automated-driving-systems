<?xml version="1.0"?>
<!-- Gazebo 模型元数据。model.sdf 是生成物，本文件也由 gen_obstacles.py 生成
     （它含场景描述，而描述在 YAML 里，手写就会漂移）。 -->
<model>
  <name>campus_obstacles_avoid</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    贴右边的锥桶，侧向留得下车 —— 规划器应当从左侧绕过去
    由 scripts/gen_obstacles.py 从 config/obstacles.yaml 生成。
  </description>
</model>
