# =============================================================================
#  预测轨迹上的一个点 —— ads_prediction → 下游（P7 时空联合的输入契约）
#
#  ⚠️ 与 TrajectoryPoint（规划→控制）是**两套语义，不许混用**：
#     那边是 ego 的期望轨迹（后轴中心、弧长参数化 s_m、含加速度前馈契约），
#     这边是**他车**的预测（包围盒中心、时间参数化 t_s、含不确定椭圆）。
#     复用那条消息的话，"points 空 = 规划器挂了"的降级语义会互相污染。
#
#  时间参数化是本消息**存在的理由**：P7 要回答"t 秒后它在哪、我在哪"，
#  没有每点的 t 就只能重来（P6-0 后果 3）。
# =============================================================================

# 相对本条轨迹 header.stamp 的时间，s，从 0 起递增。
float64 t_s

# 位置与朝向，map 系。位置是**包围盒中心**（与 Obstacle.pose 同一个点）。
# 朝向是该时刻的运动方向；静态预测时沿用输入的包围盒朝向（只摆盒子，
# 碰撞盒对 180° 对称）。
float64 x_m
float64 y_m
float64 heading_rad

# 该时刻的速率，m/s。静态预测恒为 0。
float64 speed_mps

# 不确定椭圆半轴（1σ），m：沿运动方向 / 垂直运动方向。
# 增长律与参数依据见 docs/modules/prediction.md §3。
# ⚠️ 椭圆是"诚实的不知道"，不是装饰：P7 的让行判断要用它算包络。
float64 sigma_along_m
float64 sigma_cross_m
