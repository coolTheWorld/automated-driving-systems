# =============================================================================
#  P0a 默认 RViz 布局：点云 + TF + 车模型
#
#  ⚠️ 两个容易踩的坑，都已经在下面配好，改动时留意：
#
#  1. RobotModel 的 Description Topic 必须用 Transient Local 持久性。
#     robot_state_publisher 只在启动时发一次 /robot_description（latched）。
#     RViz 若用默认的 Volatile 订阅，晚启动就永远收不到 ——
#     现象是 TF 正常、点云正常，唯独车是空的，而且不报任何错。
#
#  2. PointCloud2 的 Reliability 必须用 Best Effort。
#     发布端 pointcloud_to_base_link 用的是 SensorDataQoS（best-effort）。
#     RViz 默认是 Reliable，而 best-effort 发布者 + reliable 订阅者
#     **QoS 不兼容**，连接根本建立不起来，同样是静默地什么都不显示。
#
#  ⚠️ 从 RViz 图形界面「Save Config」会重写本文件并**删掉以上注释**。
#     调完布局要保存的话，记得把这段注释补回来。
# =============================================================================
Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
      Splitter Ratio: 0.5
    Tree Height: 640
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 5
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description File: ""
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Name: RobotModel
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 1.5
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree Height: 200
      Update Interval: 0
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      # 按 z 高度染色：地面和障碍物一眼分得开，比单色好用得多
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: LidarPoints
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.03
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /lidar/points
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    # 固定坐标系用 map：这样车在画面里是动的、世界是静的。
    # 换成 base_link 则变成车不动、世界倒着跑 —— 调传感器外参时那样更方便。
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 30
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.6
      # 相机跟着车走。留空则相机固定在世界里，车开出去就跑出画面了。
      Target Frame: base_link
      Value: Orbit (rviz_default_plugins)
      Yaw: 3.1
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  Views:
    collapsed: true
  Width: 1600
  X: 60
  Y: 40
