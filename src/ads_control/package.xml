<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ads_control</name>
  <version>0.1.0</version>
  <description>
    路径跟踪控制：横向 Stanley + 纵向速度规划与速度环 PID（SPEC §3.2）。

    输入是 /route/path（ads_map 发布的全局路径）、TF map→base_link 与 /odom，
    输出是 /vehicle_cmd（前轮转角 rad + 纵向加速度 m/s²，SPEC §4.1 的规范话题）。

    ⚠️ 本包**不依赖 ads_map**。两者是 SPEC §3.3 意义上的两个模块，
    只通过 ROS 话题通信，不允许跨模块直接函数调用 —— 否则换一个路径来源
    （P3 的规划器）就要动控制器。代价是 Pose2D 这类 POD 结构各有一份，
    这是有意接受的重复：它没有逻辑，不会"改出分歧"。

    按 SPEC §3.3 分层：lib/ 是纯 C++17 无 ROS 依赖的算法，node/ 是 ROS 包装层。
    数学推导、参数含义与已知边界见 docs/modules/control.md。
  </description>
  <maintainer email="31771510+coolTheWorld@users.noreply.github.com">孙帅</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 角度归一化与最短角度差。本仓库自己的纯 C++ 公共库，不是第三方依赖，
       且它同样禁止链接 ROS，不会破坏本包「lib/ 无 ROS」的约束。

       为什么控制器一定要用它：航向误差是**周期量**。裸写 to - from 在跨越
       ±π 时会得到接近 ±2π 的值，控制器据此打满方向盘。本包有两处必须用它 ——
       曲率的中心差分（docs/modules/control.md §2.2）和航向误差（§2.4）。 -->
  <depend>ads_common</depend>

  <!-- 以下全部只服务于 node/control_node.cpp（ROS 包装层）。
       lib/ 那一半（libads_control.so）一个都不链接 —— 由 CMakeLists 里
       target_link_libraries 的 PRIVATE 约束 + verify 脚本的 ldd 机械保证。 -->
  <depend>rclcpp</depend>
  <depend>ads_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <!-- 诊断量（横向误差、目标/实测速度、单拍耗时）用 DiagnosticArray 发出来，
       给 scripts/record_control_run.py 和 rqt 用。
       用它而不是往 ads_msgs 里加一条新消息，有两个理由：
       ① 改 ads_msgs 影响所有下游模块，是 CLAUDE.md 的「先问后做」项；
       ② 这些是**调试量**不是模块间契约，放进 SPEC §4.1 的消息集里名不正言不顺。
       diagnostic_msgs 是 ROS 2 核心接口包（common_interfaces），镜像里已有，
       不是新引入的第三方依赖。 -->
  <depend>diagnostic_msgs</depend>
  <!-- 假车节点（test/fake_vehicle_node.cpp）要发 /clock。仅测试用。 -->
  <depend>rosgraph_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <!-- clang-format 取代默认的 uncrustify，见 .clang-format 顶部说明 -->
  <test_depend>ament_cmake_clang_format</test_depend>
  <!-- L1 测试用 gtest：控制律与路径预处理全部脱离 ROS 测，毫秒级。 -->
  <test_depend>ament_cmake_gtest</test_depend>
  <!-- L3-G 闭环（test_closed_loop.py）：不需要 GPU 的端到端接线测试。
       它要起 map_node，所以运行期需要 ads_map —— 但只在测试时需要，
       用 test_depend 而不是 depend，免得给 lib/ 引入一个它不该有的依赖。 -->
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>ads_map</test_depend>
  <!-- L3-G 的链路里现在有 planning_node（P3-S4 起 control_node 吃轨迹）。
       只在测试时需要，所以是 test_depend —— 用 depend 会给 lib/ 引入
       一个它不该有的依赖，还会让 ads_planning ↔ ads_control 看起来像互相依赖。 -->
  <test_depend>ads_planning</test_depend>
  <test_depend>tf2_ros</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
