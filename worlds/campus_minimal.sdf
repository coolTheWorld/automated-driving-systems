<?xml version="1.0" ?>
<!-- ===========================================================================
     campus_minimal —— P0a 的最小可用世界

     刻意做得极简：地面 + 一段直路 + 几个方块障碍。原因见 tasks/plan.md §3 ——
     这个阶段要验证的是「仿真链路通不通」，不是场景像不像。世界越简单，
     RTF 越高、启动越快、出问题时变量越少。真实的园区场景等 P1 有了地图再说。

     命名前缀 campus_ 是为了和后面的 campus_full / campus_intersection 归成一类。
     =========================================================================== -->
<sdf version="1.9">
  <world name="campus_minimal">

    <!-- =====================================================================
         物理
         =====================================================================
         步长 1 ms 是带轮胎接触的车辆仿真的常规值。步长放大到 5 ms 以上，
         轮胎接触力的求解会不稳定，表现是车在静止时自己抖动、缓慢漂移。

         real_time_factor 设 1.0 表示「尽量按真实时间跑」。任务 2.6 要测的
         实测 RTF 就是拿实际速度跟这个目标比。 -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- =====================================================================
         大地坐标原点（S3 加：navsat 传感器需要它才能把 x/y 换算成经纬度）

         没有这一段，navsat 传感器会报 "world has no spherical coordinates"
         并且不发数据。数值随便取一个园区尺度的点即可 —— P0a 不关心真实地理
         位置，但**两个仿真环境必须用同一个原点**，否则 CARLA 与 Gazebo 里
         同一个 x/y 会对应到不同经纬度，P4 用 GNSS 做定位时结果无法互相比对。
         ENU：x 向东、y 向北、z 向上，与 ROS 的 map 系约定一致。 -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>31.230416</latitude_deg>
      <longitude_deg>121.473701</longitude_deg>
      <elevation>10.0</elevation>
      <heading_deg>0.0</heading_deg>
    </spherical_coordinates>

    <!-- =====================================================================
         系统插件

         S2 时只挂了前三个，为的是让 2.6 测到「纯物理」的 RTF 基准值。
         S3 加装传感器相关的三个系统，它们各自的代价很不一样：

           Sensors  —— 拉起独立的渲染线程给 gpu_lidar 做深度渲染。
                       这是 RTF 的**主要新增开销**，32×1800 = 57600 条射线
                       每秒渲 10 次。S3 结束时要重测 RTF 与 S2 对比，
                       差值就是激光雷达的代价。
           Imu      —— 纯数值积分，开销可忽略。
           NavSat   —— 一次坐标换算，开销可忽略。

         <render_engine> 必须显式写 ogre2：默认值在无头模式下可能落到 ogre(1)，
         而 gpu_lidar 只在 ogre2 下工作，落错了的表现是点云话题存在但永远没数据。 -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system"
            name="gz::sim::systems::NavSat"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.82 0.9 1</background>
      <!-- 关阴影。ODD 限定白天晴朗（SPEC §2），阴影对算法毫无价值，
           但它是 RTF 的头号消耗项之一。 -->
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

    <!-- 地面 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material>
            <ambient>0.35 0.45 0.32 1</ambient>
            <diffuse>0.4 0.52 0.36 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- =====================================================================
         直路：100 m × 7 m，双车道宽度。
         用一块薄板贴在地面上，纯视觉参照物，不参与碰撞（没有 collision 标签）——
         省下一份接触计算。 -->
    <model name="road">
      <static>true</static>
      <pose>40 0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="surface">
          <geometry><box><size>100 7 0.01</size></box></geometry>
          <material>
            <ambient>0.22 0.22 0.24 1</ambient>
            <diffuse>0.28 0.28 0.3 1</diffuse>
          </material>
        </visual>
        <!-- 中心分道线 -->
        <visual name="center_line">
          <pose>0 0 0.006 0 0 0</pose>
          <geometry><box><size>100 0.15 0.01</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.8 1</ambient>
            <diffuse>0.95 0.95 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- =====================================================================
         静态障碍物

         摆成左右交错，这样 S4 的「键盘开车绕障碍物一圈」需要真的打方向，
         而不是一脚油门直着开过去 —— 摆成一排的话那个验收等于没验。
         尺寸取 1 m 见方，比车小，撞上去是明确的失败信号而不是卡死。 -->
    <model name="obstacle_1">
      <static>true</static>
      <pose>15 1.6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1 1 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 1 1</size></box></geometry>
          <material>
            <ambient>0.7 0.35 0.1 1</ambient><diffuse>0.85 0.45 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="obstacle_2">
      <static>true</static>
      <pose>30 -1.6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1 1 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 1 1</size></box></geometry>
          <material>
            <ambient>0.7 0.35 0.1 1</ambient><diffuse>0.85 0.45 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="obstacle_3">
      <static>true</static>
      <pose>45 1.6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1 1 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 1 1</size></box></geometry>
          <material>
            <ambient>0.7 0.35 0.1 1</ambient><diffuse>0.85 0.45 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 一堵墙，给 S3 的激光雷达一个大面积回波目标。
         点云调试时，平整的大面比零散小方块好判断对错得多。 -->
    <model name="wall">
      <static>true</static>
      <pose>70 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 12 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 12 3</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- =====================================================================
         自车。模型本体在 models/ego_vehicle/，靠 GZ_SIM_RESOURCE_PATH 找到
         （已在 docker-compose.local.yml 里设成 /workspace/models）。

         起点放在路的起始端、道路中心线右侧半个车道处，车头朝 +x。 -->
    <include>
      <uri>model://ego_vehicle</uri>
      <name>ego_vehicle</name>
      <pose>0 -1.75 0 0 0 0</pose>
    </include>

  </world>
</sdf>
